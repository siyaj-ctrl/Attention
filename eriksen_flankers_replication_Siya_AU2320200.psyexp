        <Param val="True" valType="bool" updates="constant" name="syncScreenRefresh"/>
      </KeyboardComponent>
    </Routine>
  </Routines>
  <Flow>
    <Routine name="Introduction"/>
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'S_Number': 1, 'condition': 'Same as Target', 'spacing': 'Close', 'spacing_deg': 0.06, 'target': 'H', 'stimulus': 'HHHHHHH', 'correct': 'left'}, {'S_Number': 2, 'condition': 'Same as Target', 'spacing': 'Close', 'spacing_deg': 0.06, 'target': 'K', 'stimulus': 'KKKKKKK', 'correct': 'left'}, {'S_Number': 3, 'condition': 'Same as Target', 'spacing': 'Close', 'spacing_deg': 0.06, 'target': 'S', 'stimulus': 'SSSSSSS', 'correct': 'right'}, {'S_Number': 4, 'condition': 'Same as Target', 'spacing': 'Close', 'spacing_deg': 0.06, 'target': 'C', 'stimulus': 'CCCCCCC', 'correct': 'right'}, {'S_Number': 5, 'condition': 'Same as Target', 'spacing': 'Medium', 'spacing_deg': 0.5, 'target': 'H', 'stimulus': 'HHHHHHH', 'correct': 'left'}, {'S_Number': 6, 'condition': 'Same as Target', 'spacing': 'Medium', 'spacing_deg': 0.5, 'target': 'K', 'stimulus': 'KKKKKKK', 'correct': 'left'}, {'S_Number': 7, 'condition': 'Same as Target', 'spacing': 'Medium', 'spacing_deg': 0.5, 'target': 'S', 'stimulus': 'SSSSSSS', 'correct': 'right'}, {'S_Number': 8, 'condition': 'Same as Target', 'spacing': 'Medium', 'spacing_deg': 0.5, 'target': 'C', 'stimulus': 'CCCCCCC', 'correct': 'right'}, {'S_Number': 9, 'condition': 'Same as Target', 'spacing': 'Wide', 'spacing_deg': 1, 'target': 'H', 'stimulus': 'HHHHHHH', 'correct': 'left'}, {'S_Number': 10, 'condition': 'Same as Target', 'spacing': 'Wide', 'spacing_deg': 1, 'target': 'K', 'stimulus': 'KKKKKKK', 'correct': 'left'}, {'S_Number': 11, 'condition': 'Same as Target', 'spacing': 'Wide', 'spacing_deg': 1, 'target': 'S', 'stimulus': 'SSSSSSS', 'correct': 'right'}, {'S_Number': 12, 'condition': 'Same as Target', 'spacing': 'Wide', 'spacing_deg': 1, 'target': 'C', 'stimulus': 'CCCCCCC', 'correct': 'right'}, {'S_Number': 13, 'condition': 'Response Compatible', 'spacing': 'Close', 'spacing_deg': 0.06, 'target': 'H', 'stimulus': 'KKKHKKK', 'correct': 'left'}, {'S_Number': 14, 'condition': 'Response Compatible'